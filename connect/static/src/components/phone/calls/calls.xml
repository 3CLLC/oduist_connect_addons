<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Calls detail-->
    <t t-name="connect.call_detail" owl="1">
        <div t-if="state.call" class="o_phone_call_details flex-column">
            <t t-if="state.call.called_users[0] === user">
                <t t-set="caller_id" t-value="state.call.partner or state.call.caller_user"/>
            </t>
            <t t-else="">
                <t t-set="caller_id" t-value="state.call.partner or state.call.called_users"/>
            </t>
            <t t-if="Array.isArray(caller_id)">
                <t t-set="caller_id" t-value="caller_id[1]"/>
            </t>
            <t t-if="caller_id">
                <t t-set="full_caller_id" t-value="caller_id"/>
                <t t-set="caller_list" t-value="caller_id.split(',')"/>
                <t t-set="caller_id" t-value="caller_list[caller_list.length -1]"/>
            </t>
            <t t-else="">
                <t t-set="full_caller_id" t-value="''"/>
            </t>

            <t t-if="state.call.called_users[0] === user">
                <t t-set="caller" t-value="state.call.caller"/>
            </t>
            <t t-else="">
                <t t-set="caller" t-value="state.call.called"/>
            </t>
            <t t-if="state.call.partner">
                <t t-set="avatar" t-value="'/web/image?model=res.partner&amp;field=avatar_128&amp;id=' + state.call.partner[0]"/>
            </t>
            <t t-else="">
                <t t-set="avatar" t-value="'/connect/static/src/images/default_contact.jpg'"/>
                <t t-if="state.call.called_users[0] === user">
                    <t t-if="state.call.caller_user" t-set="avatar" t-value="'/web/image?model=res.users&amp;field=avatar_128&amp;id=' + state.call.caller_user[0]"/>
                </t>
                <t t-else="">
                    <t t-if="state.call.called_users.length > 0" t-set="avatar" t-value="'/web/image?model=res.users&amp;field=avatar_128&amp;id=' + state.call.called_users[0]"/>
                </t>
            </t>
            <div class="o_phone_call_details flex-column">
                <img alt="Avatar" class="o_partner_avatar" t-att-src="avatar"/>
                <span t-if="caller_id" class="o_partner_name"><t t-out="caller_id"/></span>
                <span class="o_partner_name"><t t-out="caller"/></span>
                <span t-if="state.call.duration_human" class="o_partner_name"><t t-out="state.call.duration_human"/></span>
                <div class="text-center action-container" title="Customer" t-if="!(state.call.called_users.length > 0 and state.call.caller_user)">
                    <button class="btn  p-3 border rounded-circle" t-on-click="_createOpenPartner">
                        <i aria-label="Customer" class="fa fa-fw fa-lg fa-user"/>
                    </button>
                </div>
                <div class="text-center action-container" title="Open in History">
                    <button class="btn  p-3 border rounded-circle" t-on-click="_OpenInCallHistory">
                        <i aria-label="Open in History" class="fa fa-fw fa-lg fa-address-card"/>
                    </button>
                </div>
            </div>
        </div>
    </t>

    <!-- Calls -->
    <t t-name="connect.calls" owl="1">
        <div t-attf-class="{{ state.call ? 'o_hide' : '' }} o_history_list">
            <t t-if="state.calls">
                <table class="o_history_table">
                    <t t-foreach="state.calls" t-as="call" t-key="call.id">
                        <!-- Transfer recipient logic: show original caller -->
                        <t t-if="call.is_transfer_recipient">
                            <t t-set="caller_id" t-value="call.display_caller_info.original_partner or call.display_caller_info.original_caller_user or call.display_caller_info.original_caller"/>
                            <t t-set="caller" t-value="call.display_caller_info.original_caller"/>
                            <t t-set="transfer_info" t-value="call.display_caller_info.transferring_user"/>
                        </t>
                        <!-- Regular incoming call logic -->
                        <t t-elif="call.direction === 'incoming'">
                            <!-- For incoming calls, always show external caller info -->
                            <t t-set="caller_id" t-value="call.partner or call.caller_user or call.caller"/>
                            <t t-set="caller" t-value="call.caller"/>
                            <t t-set="transfer_info" t-value="false"/>
                        </t>
                        <!-- Outgoing call logic -->
                        <t t-else="">
                            <t t-set="called_users" t-value="call.called_users.length > 0 ? call.called_users : false"/>
                            <t t-set="caller_id" t-value="call.partner or called_users or call.called"/>
                            <t t-set="caller" t-value="call.called"/>
                            <t t-set="transfer_info" t-value="false"/>
                        </t>
                        <!-- Process caller_id for display (handle array format) -->
                        <t t-if="Array.isArray(caller_id)">
                            <t t-set="caller_id" t-value="caller_id[1]"/>
                        </t>
                        
                        <!-- Avatar and caller_id processing -->
                        <t t-if="call.is_transfer_recipient">
                            <!-- Transfer: Use original partner/caller info -->
                            <t t-if="call.display_caller_info.original_partner">
                                <t t-set="full_caller_id" t-value="caller_id"/>
                                <t t-if="caller_id and caller_id.includes and caller_id.includes(',')">
                                    <t t-set="caller_list" t-value="caller_id.split(',')"/>
                                    <t t-set="caller_id" t-value="caller_list[caller_list.length -1].trim()"/>
                                </t>
                                <t t-set="avatar" t-value="'/web/image?model=res.partner&amp;field=avatar_128&amp;id=' + call.display_caller_info.original_partner[0]"/>
                            </t>
                            <t t-elif="call.display_caller_info.original_caller_user">
                                <t t-set="avatar" t-value="'/web/image?model=res.users&amp;field=avatar_128&amp;id=' + call.display_caller_info.original_caller_user[0]"/>
                            </t>
                            <t t-else="">
                                <t t-set="avatar" t-value="'/connect/static/src/images/default_contact.jpg'"/>
                            </t>
                        </t>
                        <t t-elif="call.direction === 'incoming'">
                            <!-- Incoming call: Show external caller avatar (partner or default) -->
                            <t t-if="call.partner">
                                <t t-set="full_caller_id" t-value="caller_id"/>
                                <t t-if="caller_id and caller_id.includes and caller_id.includes(',')">
                                    <t t-set="caller_list" t-value="caller_id.split(',')"/>
                                    <t t-set="caller_id" t-value="caller_list[caller_list.length -1].trim()"/>
                                </t>
                                <t t-set="avatar" t-value="'/web/image?model=res.partner&amp;field=avatar_128&amp;id=' + call.partner[0]"/>
                            </t>
                            <t t-elif="call.caller_user">
                                <!-- External caller is an internal user -->
                                <t t-set="avatar" t-value="'/web/image?model=res.users&amp;field=avatar_128&amp;id=' + call.caller_user[0]"/>
                            </t>
                            <t t-else="">
                                <!-- Default external caller avatar -->
                                <t t-set="avatar" t-value="'/connect/static/src/images/default_contact.jpg'"/>
                            </t>
                        </t>
                        <t t-else="">
                            <!-- Outgoing call: Show called party avatar -->
                            <t t-set="avatar" t-value="'/connect/static/src/images/default_contact.jpg'"/>
                            <t t-if="call.partner">
                                <t t-set="avatar" t-value="'/web/image?model=res.partner&amp;field=avatar_128&amp;id=' + call.partner[0]"/>
                            </t>
                            <t t-elif="call.called_users.length > 0">
                                <t t-set="avatar" t-value="'/web/image?model=res.users&amp;field=avatar_128&amp;id=' + call.called_users[0]"/>
                            </t>
                        </t>

                        <tr class="d-flex" t-attf-class="{{call.is_missed ? 'missed-call' : ''}} {{call.is_transfer_recipient ? 'transfer-call' : ''}}">
                            <td class="o_call_icon" t-attf-class="{{call.is_missed ? 'missed-call' : ''}}">
                                <div class="call-icon" t-on-click="() => this._open_detail(call)"
                                     title="Click to view detail">
                                    <!-- Call flow icons based on type -->
                                    <t t-if="call.direction === 'outgoing'">
                                        <!-- Outgoing call - always show outgoing arrow -->
                                        <i class="oi oi-arrow-up-right" title="Outgoing call"/>
                                    </t>
                                    <t t-elif="call.is_transfer_recipient">
                                        <!-- Current user received a transfer -->
                                        <i class="fa fa-exchange fa-lg" title="Call transferred"/>
                                    </t>
                                    <t t-elif="!call.answered_user">
                                        <!-- Incoming call - nobody answered at all -->
                                        <i class="fa fa-times-circle fa-lg text-danger" title="Missed call"/>
                                    </t>
                                    <t t-else="">
                                        <!-- Incoming call - someone answered -->
                                        <i class="oi oi-arrow-down-left" title="Incoming call"/>
                                    </t>
                                </div>
                            </td>
                            <td class="o_history_info w-100 d-flex flex-row" t-attf-class="{{call.is_missed ? 'missed-call' : ''}} {{call.is_transfer_recipient ? 'transfer-call' : ''}}">
                                <div class="d-flex flex-column info-card"
                                     t-on-click="() => this._onClickContactCall(caller)"
                                     t-attf-title="Call to {{caller}}"
                                     t-attf-class="{{call.is_transfer_recipient ? 'transfer-call' : ''}}">
                                    <!-- Call type badge in top right -->
                                    <t t-if="call.is_transfer_recipient and transfer_info">
                                        <span class="call-type-badge transfer-badge" t-attf-title="Transferred from {{Array.isArray(transfer_info) ? transfer_info[1] : transfer_info}}">via <t t-if="Array.isArray(transfer_info)" t-out="transfer_info[1].split(' ')[0]"/><t t-else="" t-out="transfer_info.split(' ')[0]"/></span>
                                    </t>
                                    <t t-elif="call.call_pattern === 'ring_group'">
                                        <span class="call-type-badge ring-group-badge" title="Ring Group Call - Multiple people called">Group</span>
                                    </t>
                                    <t t-else="">
                                        <span class="call-type-badge direct-call-badge" title="Direct Call - Called one person">Direct</span>
                                    </t>
                                    <div>
                                        <div class="card-identifier" t-attf-class="{{call.is_missed ? 'missed-call-text' : ''}}">
                                            <t t-out="caller_id"/>
                                        </div>
                                    </div>
                                    <div class="card-date" t-attf-class="{{call.is_missed ? 'missed-call-text' : ''}}">
                                        <t t-out="call.create_date"/>
                                    </div>
                                    <div class="card-date" t-attf-class="{{call.is_missed ? 'missed-call-text' : ''}}">
                                        <t t-out="caller"/>
                                    </div>
                                    <!-- Show transfer information on separate line -->
                                    <t t-if="call.is_transfer_recipient and transfer_info">
                                        <div class="card-date transfer-info">
                                            <i class="fa fa-share me-1" title="Transferred"/>
                                            <span class="transfer-text">via <t t-if="Array.isArray(transfer_info)" t-out="transfer_info[1]"/><t t-else="" t-out="transfer_info"/></span>
                                        </div>
                                    </t>
                                </div>
                                <div class="o_favorite">
                                    <button aria-label="Favorite" t-attf-title="Add {{caller_id}} to Favorites"
                                            t-on-click="() => this._onClickFavorite(call)">
                                        <i t-attf-class="fa {{call.favorite ? 'fa-star' : 'fa-star-o'}}"/>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </t>
                </table>
            </t>
        </div>
        <div t-if="state.call" class="o_history_list">
            <div class="o_call_detail_header">
                <i class="fa fa-arrow-circle-left" t-on-click="_close_call_detail"/>
            </div>
            <CallDetail call="state.call"/>
        </div>
    </t>

</templates>